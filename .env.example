# PersonaShield AI — Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# NEVER commit .env to version control.

# Application
ENVIRONMENT=development
APP_NAME="PersonaShield AI"
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
SECRET_KEY=

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Database (PostgreSQL 17 with pgvector)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:5432/POSTGRES_DB

# File Storage & Upload Security
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Allowed MIME Types (comma-separated)
ALLOWED_MIME_TYPES=image/png,image/jpeg,application/pdf,image/webp

# Allowed Extensions (comma-separated)
ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.pdf,.webp
